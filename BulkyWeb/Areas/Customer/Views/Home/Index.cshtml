@model IEnumerable<Product>

<div class="container-fluid py-3">
    <div class="row g-4 pb-3 justify-content-center">
        @foreach (var product in Model)
        {
            <div class="col-lg-4 col-md-6 col-sm-6">
                <div class="card product-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                    <div class="product-img-wrapper d-flex align-items-center justify-content-center">
                        @if (product.ProductImages != null && product.ProductImages.Count() > 0)
                        {
                            <img src="@product.ProductImages.FirstOrDefault().ImageUrl" class="product-img" />
                        }
                        else
                        {
                            <img src="https://placehold.co/500x600/png" class="product-img" />
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <p class="card-title h6 text-dark text-uppercase text-center mb-1">@product.Title</p>
                        <p class="text-success text-center small mb-2">by <b>@product.Author</b></p>

                        <div class="text-center mb-3">
                            <span class="text-muted text-decoration-line-through small me-2">@product.ListPrice.ToString("C")</span>
                            <span class="text-success fw-bold">@product.Price100.ToString("C")</span>
                        </div>

                        <a asp-action="Details" asp-route-productId="@product.Id"
                           class="btn btn-success bg-gradient border-0 mt-auto">
                            Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e6f2e9;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 128, 0, 0.12) !important;
    }

    .product-img-wrapper {
        height: 220px;
        background-color: #f4faf5;
        border-bottom: 1px solid #e6f2e9;
        padding: 10px;
    }

    .product-img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
    }
</style>